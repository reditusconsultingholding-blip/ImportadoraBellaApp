DATABASE_URL="file:./dev.db"

# Firma las cookies de sesión. Generar uno propio para producción:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Motor del agente Jarvis (console.anthropic.com).
ANTHROPIC_API_KEY=""

# Shopify — app "Jarvin Panal" del Dev Dashboard. Con CLIENT_ID + CLIENT_SECRET
# el token se pide y se renueva solo cada ~24h (client credentials grant); si en
# cambio pegás un token fijo de app personalizada en Conexiones, se usa ese.
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
# Opcional: token fijo (shpat_...) por variable de entorno en vez de por panel.
SHOPIFY_ADMIN_TOKEN=""
# Version de la Admin API. Por defecto 2025-04 (la del sistema en producción).
SHOPIFY_API_VERSION=""

# Código que hay que tipear al crear un usuario desde Usuarios. Por defecto 190300.
USER_CREATION_CODE=""

# Meta for Developers — app propia para consumir la Marketing API.
META_APP_ID=""
META_APP_SECRET=""

# TikTok for Business — app de Marketing API, requiere aprobación de TikTok.
TIKTOK_APP_ID=""
TIKTOK_APP_SECRET=""

# Protege /api/cron/sync (lo llama Vercel Cron cada 15 min, ver vercel.json).
# Generar uno propio: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
CRON_SECRET=""
