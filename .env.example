# Variables de entorno de Jarvis.
#
# Este archivo va en el repositorio y NUNCA lleva valores reales. Los valores
# de producción viven solo en Railway (servicio web → Variables). Para
# desarrollo, copiar a `.env` (que está en .gitignore) y completar.
#
# Generar un secreto aleatorio:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ─── Obligatorias ────────────────────────────────────────────────────────────

# Postgres de Supabase. Project Settings → Database → Connection string,
# modo "Transaction" (puerto 6543).
DATABASE_URL=""

# Firma las cookies de sesión (HS256). Sin esto la app no arranca en
# producción. Cambiarlo cierra TODAS las sesiones abiertas.
SESSION_SECRET=""

# Cifra en reposo los tokens de terceros guardados en la base (Notion, Shopify,
# Dropi, cuentas publicitarias). 32 bytes: 64 caracteres hex (comando de
# arriba). Si falta, se usa una llave derivada de SESSION_SECRET; al cargarla,
# el reloj vuelve a cifrar todo con esta en los 5 minutos siguientes.
# NO cambiarla una vez cargada: los tokens cifrados con la anterior se pierden
# (hay que reconectar las integraciones).
ENCRYPTION_KEY=""

# Protege /api/cron/* (respaldo del reloj interno). Sin esto esos endpoints
# quedan cerrados para todos.
CRON_SECRET=""

# ─── Datos de publicidad y tienda ────────────────────────────────────────────

# Windsor.ai: única fuente de Meta Ads y TikTok Ads (onboard.windsor.ai → API key).
WINDSOR_API_KEY=""

# Shopify — app del Dev Dashboard. Con CLIENT_ID + CLIENT_SECRET el token se
# pide y se renueva solo (client credentials grant).
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
# Opcional: token fijo (shpat_...) en vez de las credenciales de arriba.
SHOPIFY_ADMIN_TOKEN=""
# Opcional: versión de la Admin API. Por defecto 2025-04.
SHOPIFY_API_VERSION=""

# ─── IA ──────────────────────────────────────────────────────────────────────

# Motor del agente Jarvis y de los análisis (console.anthropic.com).
ANTHROPIC_API_KEY=""

# ─── Correo y notificaciones ─────────────────────────────────────────────────

# Resend (resend.com): reportes diarios, semanales y alertas por correo.
RESEND_API_KEY=""
# Dominio verificado en Resend desde el que salen los correos (sin "@").
EMAIL_FROM_DOMAIN=""

# Notificaciones push del navegador. Generar el par con:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ─── Alta de usuarios ────────────────────────────────────────────────────────

# Secreto TOTP (base32) de la app autenticadora con la que se autoriza crear
# usuarios. Recomendado sobre el código fijo.
USER_CREATION_TOTP_SECRET=""
# Alternativa: código fijo que hay que tipear al crear un usuario. Sin ninguna
# de las dos, crear usuarios no pide código.
USER_CREATION_CODE=""

# ─── Opcionales ──────────────────────────────────────────────────────────────

# URL pública de la app (https://jarvisecom.com). Se usa en los enlaces de los
# correos y como origen permitido de las peticiones.
APP_URL=""
# Marca de la versión desplegada, visible en /api/health.
APP_BUILD=""
# "1" para que el reloj interno (sincronización cada 5 min) también corra en
# desarrollo. Por defecto solo corre en producción.
RELOJ_EN_DESARROLLO=""
