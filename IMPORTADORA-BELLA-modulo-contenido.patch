+  dia: string;
+  titulo: string;
+  subtitulo: string | null;
+  estado: string;
+  href: string;
+};
+
+type Datos = { eventos: Evento[]; tareasPorDia: Record<string, number> };
+const VACIO: Datos = { eventos: [], tareasPorDia: {} };
+
