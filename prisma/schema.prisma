// Jarvis — esquema de datos
// Multi-tenant desde el día uno: todo cuelga de Organization,
// para poder onboardear más clientes de Reditus además de Fabrizio.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  META
  TIKTOK
}

// OWNER = Super Admin / CEO / Media Buyer (acceso total).
// DIRECTOR = Director Operativo Creativo (arma el pipeline, asigna, aprueba).
// EDITOR = Editor/Creador (solo ve y edita lo que se le asignó).
// PENDING = recién creado, sin rol asignado todavía — sin acceso a nada sensible.
enum Role {
  OWNER
  DIRECTOR
  EDITOR
  PENDING
}

enum RequirementStatus {
  PENDIENTE
  EN_EDICION
  LISTO_PARA_REVISAR
  APROBADO
  REALIZADO
  EDITADO
  TESTEADO
}

enum ActionType {
  PAUSE_CAMPAIGN
  RESUME_CAMPAIGN
  SCALE_BUDGET
}

enum ActionStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users              User[]
  adAccounts         AdAccount[]
  products           Product[]
  shopifyStores      ShopifyStore[]
  requirements       Requirement[]
  dailyReports       DailyReport[]
  profitabilityRows  ProductProfitability[]
  dropiConnections   DropiConnection[]
  employees          Employee[]
  payrollPeriods     PayrollPeriod[]
  productFolders     ProductFolder[]
  boardNotes         BoardNote[]
  chatChannels       ChatChannel[]
  chatMessages       ChatMessage[]
  calcSettings       CalcSetting[]
  acciones           ProductAction[]
  syncStates         SyncState[]
  weeklyReports      WeeklyReport[]
  productAssets      ProductAsset[]
  referencias        Referencia[]
  jarvisChats        JarvisConversacion[]
  rondas             Ronda[]
  anuncios           Anuncio[]
  eventos            EventoCalendario[]
  tareasDiarias      TareaDiaria[]
  campanasManual     CampanaManual[]
  notionConnection   NotionConnection?
  cierresSeguimiento CierreSeguimiento[]
}

// --- Chat interno --------------------------------------------------------
//
// Reemplaza los grupos de WhatsApp: canales por función y mensajes directos
// entre dos personas, en el mismo lugar donde se trabaja. Es distinto del chat
// que ya existe dentro de cada requerimiento (modelo Comment), que sigue atado
// a una pieza puntual del pipeline.

model ChatChannel {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  slug           String
  name           String
  createdAt      DateTime     @default(now())

  messages ChatMessage[]
  pins     ChatPin[]
  voz      VoicePresence[]
  senales  VoiceSignal[]

  @@unique([organizationId, slug])
}

model ChatMessage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Un mensaje va a un canal O a una persona, nunca a los dos.
  channelId   String?
  channel     ChatChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  recipientId String?
  recipient   User?        @relation("ChatReceived", fields: [recipientId], references: [id])

  authorId String
  author   User   @relation("ChatAuthored", fields: [authorId], references: [id])

  body      String
  replyToId String?
  replyTo   ChatMessage?  @relation("ChatReplies", fields: [replyToId], references: [id])
  replies   ChatMessage[] @relation("ChatReplies")

  pinned    Boolean   @default(false)
  editedAt  DateTime?
  createdAt DateTime  @default(now())

  reactions ChatReaction[]

  @@index([organizationId, channelId, createdAt])
  @@index([organizationId, recipientId, createdAt])
  @@index([organizationId, authorId, createdAt])
}

model ChatReaction {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime    @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// Hasta dónde leyó cada persona en cada conversación. El "scope" es una
// cadena — "channel:<id>" o "dm:<idDeLaOtraPersona>" — en vez de dos columnas
// que puedan ser nulas: en Postgres dos NULL no se consideran iguales, así que
// una clave única sobre columnas nulas no evitaría filas repetidas.
model ChatRead {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope  String
  readAt DateTime @default(now())

  @@unique([userId, scope])
}

// Carpetas para ordenar el catálogo. Se anidan sin límite de profundidad
// (ej. "Belleza" › "Cabello" › "Aceites"): una carpeta apunta a su madre por
// parentId, y las de primer nivel tienen parentId nulo. Borrar una carpeta
// borra sus subcarpetas, pero NO sus productos — esos vuelven a la raíz.
model ProductFolder {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  name           String
  parentId       String?
  parent         ProductFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children       ProductFolder[] @relation("FolderTree")
  color          String? // color de la tarjeta en el tablero
  // Posición de la tarjeta dentro del tablero de su carpeta madre.
  positionX      Float           @default(0)
  positionY      Float           @default(0)
  createdAt      DateTime        @default(now())

  products Product[]
  notes    BoardNote[]

  @@index([organizationId, parentId])
}

// Nota suelta del tablero: sirve para anotar una idea al lado de un producto
// sin tener que crear nada formal. Vive en una carpeta (o en la raíz) igual
// que un producto o una subcarpeta.
model BoardNote {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  folderId       String?
  folder         ProductFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  title String? // el título que se ve en la tarjeta del tablero
  body  String // la descripción / brief

  // Todo lo que un equipo de contenido necesita saber de una pieza antes de
  // grabarla. Se guardan como texto libre y no como enumeraciones cerradas
  // porque las listas cambian (aparece un formato nuevo, una red nueva) y no
  // queremos una migración cada vez.
  status      String    @default("IDEA") // IDEA | GUION | GRABACION | EDICION | REVISION | APROBADO | PUBLICADO
  priority    String    @default("MEDIA") // BAJA | MEDIA | ALTA
  dueDate     DateTime?
  format      String? // "Vertical 9:16", "Cuadrado 1:1", "Horizontal 16:9", "Imagen"
  durationSec Int? // duración objetivo del video, en segundos
  assigneeId  String?
  assignee    User?     @relation("BoardNoteAssignee", fields: [assigneeId], references: [id])
  // [{ "label": "Referencia TikTok", "url": "https://..." }]
  links       Json?

  color     String?
  positionX Float    @default(0)
  positionY Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments BoardNoteComment[]

  @@index([organizationId, folderId])
}

// Conversación de una ficha. Separado del chat interno general: acá lo que se
// habla queda pegado a la pieza, que es donde alguien lo va a buscar dentro de
// tres semanas.
model BoardNoteComment {
  id        String    @id @default(cuid())
  noteId    String
  note      BoardNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime  @default(now())

  @@index([noteId, createdAt])
}

model User {
  id                    String       @id @default(cuid())
  email                 String       @unique
  passwordHash          String
  name                  String
  role                  Role         @default(OWNER)
  mustChangePassword    Boolean      @default(false)
  // Quién ve la pantalla de Nómina. NO alcanza con ser OWNER: es un permiso
  // aparte porque el pago solo lo miran Fabricio y Katherine, y puede haber
  // otros administradores que no deban verlo.
  canViewPayroll        Boolean      @default(false)
  // Si ve el dinero: ingresos, rentabilidad, costos, la calculadora.
  //
  // Va por persona y no por rol a proposito. Si dependiera del rol, crear un
  // OWNER nuevo le daria acceso a la facturacion sin que nadie lo decidiera.
  // Por defecto NADIE lo ve; se concede a mano.
  canViewFinancials     Boolean      @default(false)
  // Foto de perfil como data URL. Se guarda en la base y no en un bucket
  // porque es una miniatura de 256px (~30 KB): montar almacenamiento de
  // archivos para eso sería más infraestructura que valor.
  avatarUrl             String?
  // Si ya vio el recorrido de la herramienta.
  //
  // Va en la base y no en el navegador porque el dueno tiene que poder
  // reiniciarla desde Usuarios: una capacitacion que solo vive en el equipo de
  // quien la vio no se puede volver a mandar.
  capacitacionVista     Boolean      @default(false)
  // Cuantas veces se le abrio SOLA. Se deja de abrir sola despues de tres.
  //
  // Antes se abria en cada entrada hasta que apretaran "Terminar" o
  // "Saltarla". Quien la cerraba con la equis para mirar algo urgente se la
  // encontraba de nuevo al dia siguiente, y al otro.
  capacitacionAperturas Int          @default(0)
  birthDate             DateTime?
  phone                 String?
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id])
  createdAt             DateTime     @default(now())

  requestedActions        PendingAction[]
  accionesJarvisPedidas   PendingAction[]      @relation("PendingActionPedida")
  accionesJarvisResueltas PendingAction[]      @relation("PendingActionResuelta")
  assignedRequirements    Requirement[]        @relation("RequirementOwner")
  comments                Comment[]
  notifications           Notification[]
  employee                Employee?
  chatAuthored            ChatMessage[]        @relation("ChatAuthored")
  chatReceived            ChatMessage[]        @relation("ChatReceived")
  chatReactions           ChatReaction[]
  chatReads               ChatRead[]
  assignedNotes           BoardNote[]          @relation("BoardNoteAssignee")
  jarvisChats             JarvisConversacion[]
  noteComments            BoardNoteComment[]
  chatPins                ChatPin[]            @relation("ChatPinsCreated")
  vozPresencia            VoicePresence[]
  vozSilenciosAplicados   VoicePresence[]      @relation("VozSilenciadoPor")
  anunciosPublicados      Anuncio[]
  anunciosVistos          AnuncioVisto[]
  eventosCreados          EventoCalendario[]
  senalesEnviadas         VoiceSignal[]        @relation("VozDe")
  senalesRecibidas        VoiceSignal[]        @relation("VozPara")
  accionesPropuestas      ProductAction[]      @relation("AccionPropuesta")
  accionesDecididas       ProductAction[]      @relation("AccionDecidida")
  accionesAsignadas       ProductAction[]      @relation("AccionAsignada")
  assetsCreados           ProductAsset[]
  referenciasCreadas      Referencia[]
  rondasACargo            Ronda[]
  pushSubscriptions       PushSubscription[]
  tareasResponsable       TareaDiaria[]        @relation("TareaResponsable")
}

// Una cuenta publicitaria conectada (Meta o TikTok). Un Organization
// puede tener varias — Fabrizio ya dijo que va a compartir varios perfiles.
model AdAccount {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  platform       Platform
  externalId     String // ad_account_id (Meta) / advertiser_id (TikTok)
  name           String
  accessToken    String? // token de larga duración una vez conectada la cuenta real
  connectedAt    DateTime?
  createdAt      DateTime     @default(now())

  campaigns Campaign[]

  @@unique([organizationId, platform, externalId])
}

// Producto identificado por el código que Fabrizio ya usa en el nombre
// de sus campañas (ej: BAT-001). Las métricas se agregan por este código.
model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  code           String // identificador que aparece en el nombre de campaña
  name           String
  cpaTarget      Float // umbral: por debajo = verde, por encima = rojo
  unitCost       Float? // costo del producto, si se carga a mano
  salePrice      Float? // precio de venta de referencia

  // Vínculo explícito al producto de Shopify, elegido desde el buscador del
  // catálogo — en vez de depender solo del nombre normalizado para saber que
  // "este" Product es "ese" producto de la tienda.
  shopifyProductId    String?
  shopifyProductTitle String?

  // La realidad operativa del producto, sin la cual "rentabilidad" es una
  // palabra vacia: en contraentrega no se cobra lo que se vende, se cobra lo
  // que se confirma Y no se devuelve. Sale de la planilla del equipo.
  efectividad       Float? // 0-1: que porcion de los checkouts se confirma
  devoluciones      Float? // 0-1: que porcion de lo despachado vuelve
  flete             Float? // costo de envio por paquete DESPACHADO
  gastoAdmPorPedido Float? // gasto administrativo repartido por pedido entregado
  economiaDe        String? // de donde salieron estos numeros y de que mes
  notes             String?
  archived          Boolean        @default(false)
  folderId          String?
  folder            ProductFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  thumbnailUrl      String?
  // Posición de la tarjeta dentro del tablero de su carpeta.
  positionX         Float          @default(0)
  positionY         Float          @default(0)
  createdAt         DateTime       @default(now())

  campaigns      Campaign[]
  acciones       ProductAction[]
  assets         ProductAsset[]
  referencias    Referencia[]
  rondas         Ronda[]
  requirements   Requirement[]
  links          ProductoLink[]
  tareas         TareaDiaria[]   @relation("TareaProducto")
  campanasManual CampanaManual[] @relation("CampanaManualProducto")

  @@unique([organizationId, code])
}

// Links de trackeo de un producto: landing, Funnelish, la propia ficha de
// Shopify, cualquier URL que el equipo use para lanzar campañas de ese
// producto. Un producto puede tener más de uno (varias landings probándose a
// la vez); todos quedan acá para poder revisarlos.
//
// El match automático campaña→producto por URL no funciona hoy (Funnelish y
// Windsor devuelven el link vacío la mayoría de las veces — ver
// src/lib/product-code.ts), así que estos links son trackeo/referencia; la
// vía confiable de atribución es la nomenclatura del lote.
model ProductoLink {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  etiqueta    String?
  esPrincipal Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([productId])
}

model Campaign {
  id          String    @id @default(cuid())
  adAccountId String
  adAccount   AdAccount @relation(fields: [adAccountId], references: [id])
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  externalId  String // campaign id en la plataforma
  name        String
  status      String // ACTIVE / PAUSED / ...
  createdAt   DateTime  @default(now())

  // Cuando alguien asigna el producto a mano desde Gestión de campañas
  // (porque el nombre no matchea solo, o matcheó mal). El sync automático de
  // Windsor y relinkCampaignsToProducts() tienen que SALTAR estas campañas —
  // si no, la siguiente sincronización de 5 minutos pisa la corrección.
  productManual Boolean @default(false)
  // Se oculta de Gestión de campañas sin perder el histórico de métricas.
  archivada     Boolean @default(false)

  // A qué lote de contenido pertenece, si su nombre trae la nomenclatura
  // {código}-{numero} (ver src/lib/nomenclatura.ts). Es lo que permite saber
  // quién hizo esta campaña y atribuirle su performance.
  rondaId String?
  ronda   Ronda?  @relation("RondaCampanas", fields: [rondaId], references: [id], onDelete: SetNull)

  // TESTEO | OPTIMIZACION | ESCALADO — inferido de la nomenclatura cuando se
  // puede, editable a mano si no.
  tipoCampana String?

  metrics        MetricSnapshot[]
  pendingActions PendingAction[]

  @@unique([adAccountId, externalId])
}

// Snapshot de métricas. Con datos reales esto se llena por polling
// periódico a la Graph API / TikTok Business API.
model MetricSnapshot {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  capturedAt  DateTime @default(now())
  spend       Float
  impressions Int
  clicks      Int
  purchases   Int
  revenue     Float

  // Una fila por campaña y día. La clave única es lo que deja volver a
  // sincronizar los últimos días sin duplicar: Meta ajusta las compras con
  // retraso, así que el mismo día se reescribe varias veces.
  @@unique([campaignId, capturedAt])
  @@index([campaignId, capturedAt])
}

// La tienda de Shopify — separada a propósito de AdAccount, porque no es
// una cuenta publicitaria: es la fuente de la vista "Ventas" (toda la
// tienda, se anuncie o no cada producto). Una organización tiene una sola.
model ShopifyStore {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  shopDomain     String // ej. importadora-bella.myshopify.com
  accessToken    String? // Admin API access token (shpat_...) de la app personalizada
  connectedAt    DateTime?
  createdAt      DateTime     @default(now())

  orders ShopifyOrder[]

  @@unique([organizationId, shopDomain])
}

model ShopifyOrder {
  id         String       @id @default(cuid())
  storeId    String
  store      ShopifyStore @relation(fields: [storeId], references: [id])
  externalId String // order id de Shopify
  occurredAt DateTime
  channel    String // source_name de la orden (ej. "Funnelish", "web")
  grossSales Float
  discounts  Float
  shipping   Float
  taxes      Float
  netSales   Float

  // A quien y a donde. Sin esto cada orden es anonima y no se puede saber
  // quien repite ni en que provincia se vende mejor.
  clienteNombre   String?
  clienteTelefono String?
  clienteEmail    String?
  provincia       String?
  ciudad          String?

  createdAt DateTime @default(now())

  lineItems ShopifyOrderLineItem[]

  @@unique([storeId, externalId])
  @@index([storeId, occurredAt])
  @@index([clienteTelefono])
  @@index([provincia])
}

model ShopifyOrderLineItem {
  id          String       @id @default(cuid())
  orderId     String
  order       ShopifyOrder @relation(fields: [orderId], references: [id])
  productName String
  category    String?
  quantity    Int
  amount      Float
}

// Pipeline creativo (SuperAds Ops). Reemplaza la hoja de cálculo: un
// Requirement es una pieza de contenido publicitario, de la idea a
// probada. Las listas de opciones (tipo de anuncio, ángulo, formato...)
// se validan en la app — quedan como String simple para poder ajustarlas
// sin migración cada vez que el equipo agrega una opción nueva.
model Requirement {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  date        DateTime @default(now())
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  adName      String
  externalId1 String?
  externalId2 String?

  adType         String // ORIGINAL, FASE 1, FASE 2 / HOOK, FASE 2 / GUION, FASE 2 / CTA, VARIANTE, IMG ANUNCIO, IMAGEN
  phase          String // F1, F2, CT 1.0, CT 4.0, OP, Escala
  visualFormat   String // diversidad semántica — formato visual
  angle          String // diversidad semántica — ángulo
  awarenessLevel String // L1..L5
  marketOrigin   String // Perú, USA, España, México, Colombia, Otro

  ownerId String?
  owner   User?   @relation("RequirementOwner", fields: [ownerId], references: [id])

  // En que punto del proceso esta la pieza: quien la tiene y que falta.
  status RequirementStatus @default(PENDIENTE)

  // Que esta haciendo la pieza EN LA PAUTA. Es otra cosa: una pieza puede
  // estar "testeada" y ser un "winner validado" o un "kill definitivo".
  // Mezclarlas hace imposible responder "cuantos winners tenemos".
  estado   String?
  // A que ronda de cuatro pertenece y que lugar ocupa dentro de ella.
  ronda    String?
  rondaId  String?
  rondaRel Ronda?  @relation(fields: [rondaId], references: [id], onDelete: SetNull)
  slot     Int?

  // De donde vino la pieza. Separa el historico del trabajo activo: seis mil
  // registros viejos en la tabla de seguimiento la vuelven inutilizable.
  origen String?

  originalVideoLink String?
  tiktokPostLink    String?
  fbPostLink        String?

  hookRate   Float?
  ctr        Float?
  holdRate   Float?
  purchases  Int?
  cpa        Float?
  frequency  Float?
  cpm        Float?
  nextAction String?
  notes      String?

  dueDate       DateTime? // fecha de entrega — la tarjeta se marca vencida si se pasó y sigue en producción
  fechaAgendada DateTime? // día en que el calendario de contenido la muestra — distinto de dueDate
  thumbnailUrl  String? // imagen de portada del creativo, para no depender solo del link

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // De que accion aprobada salio este creativo, si salio de una. Es lo que
  // permite cerrar el circulo: el producto pidio tres piezas, estas son.
  actionId String?
  action   ProductAction? @relation(fields: [actionId], references: [id], onDelete: SetNull)

  comments Comment[]
  versions RequirementVersion[]
  activity RequirementActivity[]

  @@index([organizationId, status])
}

// Historial de iteraciones de un creativo (v1, v2, v3...) — separado del
// link único original porque un editor sube varias versiones hasta que
// una se aprueba, y hoy no quedaba registro de cuál ganó.
model RequirementVersion {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id])
  label         String // "v1", "v2"...
  link          String
  note          String?
  isFinal       Boolean     @default(false)
  authorName    String
  createdAt     DateTime    @default(now())

  @@index([requirementId, createdAt])
}

// Bitácora de cambios de una pieza — quién movió el estado, quién
// reasignó, cuándo. authorName/fromValue/toValue van como snapshot de
// texto (no relaciones) para mantener el modelo liviano.
model RequirementActivity {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id])
  actorName     String
  action        String // STATUS_CHANGE | ASSIGNED | VERSION_ADDED
  fromValue     String?
  toValue       String?
  detail        String
  createdAt     DateTime    @default(now())

  @@index([requirementId, createdAt])
}

// Chat interno de cada Requirement. Se buscan @menciones en el texto al
// guardar y se genera una Notification para cada usuario mencionado.
model Comment {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id])
  authorId      String
  author        User        @relation(fields: [authorId], references: [id])
  body          String
  createdAt     DateTime    @default(now())

  @@index([requirementId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  link      String? // ej. /dashboard/pipeline?open={requirementId}
  // mention | alert_escala | alert_apagar | alert_fatiga | alert_discrepancia |
  // daily_report | asignacion
  type      String   @default("mention")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// --- Nómina -------------------------------------------------------------
//
// Una persona del equipo con su forma de pago. Se separa de User a propósito:
// no todo el que cobra necesita cuenta en la app, y no todo el que tiene
// cuenta cobra sueldo. Cuando la persona sí tiene cuenta, se enlaza por
// userId para poder contar las piezas que entregó.
//
// Los montos NO están hardcodeados en el código: los carga Fabrizio o
// Katherine desde el panel, porque son los únicos que ven esta pantalla.

enum PayMode {
  SEMANAL // monto fijo por semana
  DIARIO // monto por día trabajado
  POR_PIEZA // monto por cada creativo entregado en la semana
}

model Employee {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?      @unique
  user           User?        @relation(fields: [userId], references: [id])

  fullName    String
  position    String // "Editora de Video", "Directora Creativa"...
  payMode     PayMode @default(SEMANAL)
  payAmount   Float   @default(0)
  daysPerWeek Float   @default(6) // se usa para prorratear una ausencia
  currency    String  @default("USD")
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  absences PayrollAbsence[]
  entries  PayrollEntry[]

  @@index([organizationId, active])
}

// Un día que la persona no trabajó. Descuenta del pago de esa semana,
// salvo en POR_PIEZA (ahí el pago ya depende de lo entregado).
model PayrollAbsence {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime // medianoche del día ausente
  reason     String?
  createdAt  DateTime @default(now())

  @@unique([employeeId, date])
  @@index([employeeId, date])
}

// Una semana de pago. Se cierra cuando se paga, y ahí los montos quedan
// congelados en PayrollEntry — si después cambia el sueldo de alguien, lo
// ya pagado no se reescribe solo.
model PayrollPeriod {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  weekStart      DateTime // lunes
  weekEnd        DateTime // domingo
  status         String       @default("ABIERTA") // ABIERTA | PAGADA
  paidAt         DateTime?
  paidByName     String?
  createdAt      DateTime     @default(now())

  entries PayrollEntry[]

  @@unique([organizationId, weekStart])
  @@index([organizationId, weekStart])
}

model PayrollEntry {
  id         String        @id @default(cuid())
  periodId   String
  period     PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id])

  baseAmount      Float // lo que corresponde por sueldo/piezas antes de ajustes
  absenceDays     Float   @default(0)
  absenceDeduct   Float   @default(0)
  piecesDelivered Int     @default(0)
  bonus           Float   @default(0)
  total           Float
  note            String?

  @@unique([periodId, employeeId])
}

// Reporte diario en PDF. Un cron a medianoche (ver /api/cron/daily-report)
// genera uno por organización y notifica al/los OWNER para que lo revise.
model DailyReport {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  date           DateTime // día que resume (medianoche de ese día)
  pdf            Bytes
  createdAt      DateTime     @default(now())

  @@unique([organizationId, date])
}

// Tabla de rentabilidad por producto/mes — lo que Sebastian ya lleva en
// una planilla. Los campos "por pedido" (ingreso, gasto operativo, margen
// sin publicidad, publicidad) se calculan al leer, no se guardan, para que
// siempre reflejen los acumulados más recientes.
model ProductProfitability {
  id                    String       @id @default(cuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id])
  month                 String // ej. "ABRIL"
  productName           String
  orders                Int
  cpa                   Float
  revenueAccum          Float
  adSpendAccum          Float
  operatingExpenseAccum Float
  adminExpenseAccum     Float
  profitAccum           Float
  merchandiseAccum      Float?
  desiredProfitPerOrder Float? // objetivo manual, si lo cargan
  createdAt             DateTime     @default(now())

  @@unique([organizationId, month, productName])
}

// La cuenta de Dropi (Ecuador) para la torre logística. Separada de
// ShopifyStore/AdAccount porque es otra cosa: fulfillment y envíos, no
// ventas ni pauta.
model DropiConnection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  integrationKey String? // header dropi-integration-key, una vez que Dropi lo habilite
  country        String       @default("Ecuador")
  connectedAt    DateTime?
  createdAt      DateTime     @default(now())

  shipments Shipment[]
}

model Shipment {
  id           String          @id @default(cuid())
  connectionId String
  connection   DropiConnection @relation(fields: [connectionId], references: [id])
  externalId   String // id de la orden/guía en Dropi
  province     String // "departamento" en Colombia, "provincia" en Ecuador
  city         String
  carrier      String // transportadora
  status       String // ENTREGADO, EN_RUTA, DEVUELTO, NOVEDAD...
  isReturn     Boolean         @default(false)
  occurredAt   DateTime
  createdAt    DateTime        @default(now())

  @@unique([connectionId, externalId])
  @@index([connectionId, occurredAt])
}

// Cualquier acción que Jarvis proponga (pausar, escalar, ajustar presupuesto)
// queda acá como PENDING hasta que el usuario la aprueba explícitamente.
// Nunca se ejecuta sola — decisión tomada el 16 jul.
model PendingAction {
  id              String       @id @default(cuid())
  campaignId      String
  campaign        Campaign     @relation(fields: [campaignId], references: [id])
  requestedBy     String // "jarvis" o el id del User si la pidió una persona
  // El User que la pidió, cuando la pidió una persona. `requestedBy` es texto
  // suelto y no se puede unir con nada; esto sí.
  requestedById   String?
  requestedByUser User?        @relation("PendingActionPedida", fields: [requestedById], references: [id])
  approvedById    String?
  approvedBy      User?        @relation(fields: [approvedById], references: [id])
  // Quién resolvió y por qué.
  //
  // `approvedById` se escribe también al RECHAZAR, así que su nombre miente y
  // no sirve para leer la historia. Y sin la nota, un rechazo es un dato
  // muerto: nadie sabe si fue porque el número estaba mal o porque ya se había
  // hecho otra cosa, y la misma propuesta vuelve a aparecer la semana
  // siguiente.
  resolvedById    String?
  resolvedBy      User?        @relation("PendingActionResuelta", fields: [resolvedById], references: [id])
  resolutionNote  String?
  type            ActionType
  payload         String // JSON con el detalle (ej. nuevo presupuesto)
  reason          String // por qué Jarvis lo sugiere
  status          ActionStatus @default(PENDING)
  createdAt       DateTime     @default(now())
  resolvedAt      DateTime?

  @@index([campaignId, createdAt])
}

// Hasta 3 cosas ancladas por canal: una nota, un link, una carpeta. Es el
// lugar donde queda lo que el equipo tiene que tener a mano sin buscarlo en
// el historial. El tope de 3 es a propósito: si se pudieran anclar veinte,
// dejaría de ser un atajo y volvería a ser una lista que nadie mira.
model ChatPin {
  id          String      @id @default(cuid())
  channelId   String
  channel     ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  kind        String // NOTA | LINK
  title       String
  body        String? // texto, cuando es nota
  url         String? // destino, cuando es link
  createdById String
  createdBy   User        @relation("ChatPinsCreated", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())

  @@index([channelId])
}

// Los ajustes de la calculadora, por producto y compartidos por todo el
// equipo. Antes vivian en el estado de la pantalla y se perdian al recargar:
// dos personas de marketing podian estar mirando numeros distintos del mismo
// producto sin enterarse.
model CalcSetting {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  producto       String // nombre del producto, tal como figura en el catalogo
  data           String // JSON con los valores de la calculadora
  updatedById    String?
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, producto])
}

// Sala de voz por canal, al estilo Discord: se entra y se escucha a todos.
//
// El audio va directo entre navegadores (WebRTC en malla). Lo unico que pasa
// por el servidor es el saludo inicial: quien esta adentro y los mensajes de
// negociacion. No hay servidor de medios ni WebSocket — se consulta cada dos
// segundos, que para un equipo de diez personas alcanza y evita montar
// infraestructura nueva.
model VoicePresence {
  id              String      @id @default(cuid())
  channelId       String
  channel         ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  muted           Boolean     @default(false)
  // Camara encendida. Es una columna y no un dato que viaje suelto entre
  // navegadores porque el tope de camaras se cuenta en el servidor: si cada
  // navegador llevara su propia cuenta, dos personas prendiendo a la vez
  // pasarian el limite sin que nadie las frenara.
  camara          Boolean     @default(false)
  // Cuando levanto la mano. Es un instante y no un si/no porque la lista se
  // ordena por quien la levanto primero: con un booleano el turno quedaria en
  // orden arbitrario y la mano dejaria de servir para repartir la palabra.
  manoLevantadaAt DateTime?
  // Silencio impuesto por direccion. Se guarda QUIEN lo puso, no solo que
  // paso: un microfono que deja de andar sin explicacion se reporta como que
  // la app esta rota. Mientras este puesto el servidor ignora el `muted` que
  // manda el navegador — si no, bastaria con tocar el boton para deshacerlo.
  silenciadoPorId String?
  silenciadoPor   User?       @relation("VozSilenciadoPor", fields: [silenciadoPorId], references: [id])
  silenciadoEnAt  DateTime?
  joinedAt        DateTime    @default(now())
  // Latido. Si se deja de actualizar, la persona se cayo: cerro la pestana o
  // se quedo sin red. Sin esto la sala quedaria llena de fantasmas.
  lastSeenAt      DateTime    @default(now())

  @@unique([channelId, userId])
  @@index([channelId, lastSeenAt])
}

// Un mensaje de negociacion WebRTC de una persona a otra (oferta, respuesta o
// candidato de red). Se lee una vez y se borra: es correo, no historial.
model VoiceSignal {
  id         String      @id @default(cuid())
  channelId  String
  channel    ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User        @relation("VozDe", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User        @relation("VozPara", fields: [toUserId], references: [id], onDelete: Cascade)
  payload    String
  createdAt  DateTime    @default(now())

  @@index([toUserId, channelId, createdAt])
}

// --- Anuncios al equipo --------------------------------------------------
//
// Un aviso que direccion le manda a TODA la empresa y que aparece al entrar a
// la app hasta que cada persona lo marca como visto.
//
// Es distinto de un mensaje al canal general, y por eso no se resolvio con
// uno: un mensaje se pierde bajo la conversacion del dia y nadie sabe quien lo
// leyo. Aca la app corta el paso hasta que la persona lo acusa, y queda la
// lista de quien lo vio.
model Anuncio {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  autorId        String
  autor          User         @relation(fields: [autorId], references: [id])
  titulo         String
  cuerpo         String
  createdAt      DateTime     @default(now())
  // Retirar un anuncio NO lo borra: deja de aparecerle a quien todavia no lo
  // vio, pero se conserva quien ya lo habia acusado. Borrarlo de verdad seria
  // perder la unica prueba de que el equipo se entero.
  archivadoAt    DateTime?

  vistos AnuncioVisto[]

  @@index([organizationId, createdAt])
}

// Que persona ya acuso que vio que anuncio. Sin fila, el anuncio le sigue
// apareciendo al entrar.
model AnuncioVisto {
  id        String   @id @default(cuid())
  anuncioId String
  anuncio   Anuncio  @relation(fields: [anuncioId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vistoAt   DateTime @default(now())

  @@unique([anuncioId, userId])
  @@index([userId])
}

// --- Calendario de la empresa --------------------------------------------
//
// Un evento empresarial: reunion, feriado, lanzamiento, cierre de mes.
//
// `inicio` y `fin` son INSTANTES REALES en UTC, no marcas de dia. El servidor
// corre en UTC y el negocio es de Ecuador (UTC-5): un evento del "1 de
// septiembre" guardado como 2026-09-01T00:00Z se lee de vuelta como 31 de
// agosto a las 19:00 en Guayaquil y aparece el dia equivocado en el
// calendario. Por eso el dia y la hora que escribe la persona se convierten a
// instante en el servidor con el desfase de Ecuador (src/lib/calendario-fechas.ts),
// que es la misma distincion que hacen date-range.ts y chat/dias.ts.
//
// Cuando `todoElDia` es true, `inicio` es la medianoche ecuatoriana de ese dia
// (05:00 UTC) y la hora no se muestra.
model EventoCalendario {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  titulo         String
  descripcion    String?
  lugar          String?
  inicio         DateTime
  fin            DateTime?
  todoElDia      Boolean      @default(true)
  creadoPorId    String
  creadoPor      User         @relation(fields: [creadoPorId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([organizationId, inicio])
}

// El puente entre "este producto esta en riesgo" y "alguien hizo algo al
// respecto".
//
// Sin esto el panel diagnostica y ahi termina: el equipo lee que un producto
// se esta yendo de CPA, lo comenta por chat y no queda registro de si se
// decidio algo ni de quien lo hizo. Una accion se propone desde el producto,
// direccion la aprueba o la rechaza, y al aprobarla se le asigna a un editor
// y nacen los creativos ya vinculados de vuelta al producto.
model ProductAction {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  kind     String // MAS_CREATIVOS | ESCALAR | PAUSAR | REVISAR_OFERTA
  detail   String // que exactamente se pide
  cantidad Int? // cuantas piezas, cuando el pedido es de creativos
  reason   String // por que se propone: el numero que lo justifica

  status       String    @default("PROPUESTA") // PROPUESTA | APROBADA | RECHAZADA | HECHA
  proposedById String
  proposedBy   User      @relation("AccionPropuesta", fields: [proposedById], references: [id])
  decidedById  String?
  decidedBy    User?     @relation("AccionDecidida", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  decisionNote String?

  assigneeId String?
  assignee   User?     @relation("AccionAsignada", fields: [assigneeId], references: [id])
  dueDate    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirements Requirement[]

  @@index([organizationId, status])
  @@index([productId])
}

// Cuando se actualizo por ultima vez cada fuente, y si fallo.
//
// Existe porque el silencio y el cero se ven igual: si el cron deja de
// correr, el panel muestra "0 ventas hoy" y parece un mal dia de ventas en
// vez de una sincronizacion caida. Paso exactamente eso.
model SyncState {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  fuente         String // shopify | facebook | tiktok
  okAt           DateTime? // ultima corrida que termino bien
  errorAt        DateTime?
  error          String?
  detalle        String? // que trajo, para poder mirarlo sin entrar a la base
  // Evita que dos corridas se pisen: el reloj interno dispara cada pocos
  // minutos y una sincronizacion larga puede seguir viva cuando llega la
  // siguiente.
  corriendo      Boolean      @default(false)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, fuente])
}

// El reporte semanal de salud de productos que le llega al CEO.
//
// Se guarda que se mando, no el contenido en PDF: lo que importa es no
// mandarlo dos veces. La unicidad por semana es lo que lo garantiza, sin
// importar cuantas veces pase el reloj.
model WeeklyReport {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  weekStart      DateTime // lunes de la semana que resume
  enviadoA       String // a quienes se les mando
  resumen        String // el texto que se envio, para poder releerlo
  createdAt      DateTime     @default(now())

  @@unique([organizationId, weekStart])
}

// El repositorio de direccion creativa de un producto: carpetas, links y
// notas.
//
// Es donde vive el material del que sale un anuncio — referencias, guiones,
// piezas anteriores, lo que sea. Antes eso estaba repartido entre Drive, el
// chat y la cabeza de quien lo produjo, y cada pieza nueva empezaba de cero
// buscando de que partir.
model ProductAsset {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Las carpetas se anidan entre si; lo demas cuelga de una carpeta o de la raiz.
  parentId String?
  parent   ProductAsset?  @relation("AssetTree", fields: [parentId], references: [id], onDelete: Cascade)
  children ProductAsset[] @relation("AssetTree")

  kind  String // CARPETA | LINK | NOTA
  title String
  url   String?
  notes String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId, parentId])
}

// Banco de referencias: la materia prima del research.
//
// Lo que se encuentra afuera y sirve de punto de partida. Guardar tambien las
// ANTI-referencias importa igual: saber que no funciono evita repetirlo, y esa
// es la mitad del aprendizaje que hoy se pierde.
model Referencia {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  fecha          DateTime @default(now())
  codigo         String? // codigo o nombre con que se la identifica
  mercadoOrigen  String?
  antiguedadDias Int? // hace cuanto se publico: una referencia vieja pesa distinto
  fuente         String? // de donde salio
  formatoVisual  String?
  angulo         String?
  awarenessLevel String?
  concepto       String? // que se extrae de ella
  antiReferencia Boolean  @default(false)
  link           String?
  estado         String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId, productId])
}

// Una ronda: cuatro piezas que salen juntas a testear. Es también el "lote de
// contenido" del que habla el equipo (6 o 12 creativos por lote): un
// Requirement.rondaId agrupa las piezas y Ronda.nomenclatura es lo que el
// editor pega al nombrar la campaña en Meta/TikTok para que el sistema sepa
// quién hizo qué y de qué campaña viene cada performance.
//
// Existe para poder verificar la diversidad ANTES de producir, no despues: si
// las cuatro comparten formato y angulo, compiten entre si y la ronda entera
// mide una sola cosa.
model Ronda {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  numero        Int
  semana        String?
  fecha         DateTime @default(now())
  responsableId String?
  responsable   User?    @relation(fields: [responsableId], references: [id])
  notas         String?

  // {código del producto}-{numero}, fijado al crear el lote. Es la clave que
  // matchea una Campaign de vuelta a este lote (ver
  // src/lib/nomenclatura.ts + product-code.ts).
  nomenclatura   String?
  // Cuántos creativos debe traer el lote — el equipo maneja 6 o 12.
  tamanoObjetivo Int       @default(12)
  fechaEntrega   DateTime?
  estado         String    @default("PLANEADO") // PLANEADO | EN_PRODUCCION | ENTREGADO | TESTEANDO | CERRADO

  piezas   Requirement[]
  campanas Campaign[]    @relation("RondaCampanas")
  tareas   TareaDiaria[] @relation("TareaLote")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, productId, numero])
}

// Un navegador suscrito a las notificaciones push.
//
// Una persona puede tener varias: el telefono, la computadora del trabajo,
// la de la casa. Cada una es una suscripcion distinta y se avisa a todas.
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // El endpoint identifica al navegador de forma unica: es la clave que evita
  // registrar dos veces el mismo dispositivo.
  endpoint  String  @unique
  p256dh    String
  auth      String
  userAgent String?

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

// Las conversaciones con Jarvis, guardadas.
//
// Antes vivían solo en la memoria del navegador: al recargar la página se
// perdía todo. Una conversación donde se razonó sobre por qué un producto
// dejó de rendir vale tanto como el reporte, y desaparecía sola.
model JarvisConversacion {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  // Cada quien ve las suyas. Un chat con Jarvis es pensamiento en voz alta,
  // no un documento de la empresa.
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  titulo         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  mensajes JarvisMensaje[]

  @@index([userId, updatedAt])
}

model JarvisMensaje {
  id             String             @id @default(cuid())
  conversacionId String
  // En cascada: borrar una conversación tiene que llevarse sus mensajes, o la
  // tabla se llena de huérfanos que nadie puede ver ni borrar.
  conversacion   JarvisConversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  rol            String // user | assistant
  contenido      String
  createdAt      DateTime           @default(now())

  @@index([conversacionId, createdAt])
}

// --- Contenido (reemplaza Notion + WhatsApp) -----------------------------
//
// Tres piezas: el tablero día a día (TareaDiaria), la gestión de campañas
// para las que todavía no hay una Campaign sincronizada (CampanaManual), y la
// conexión de import único desde Notion (NotionConnection). El pipeline
// Kanban se quitó — Requirement y Ronda siguen siendo el registro real de
// "pieza de creativo" y "lote", solo que ahora se muestran desde acá.

// Una fila del tablero de tareas diarias: qué hizo cada persona, en qué
// producto, en qué plataforma, qué falta. Reemplaza la base de Notion del
// mismo nombre.
model TareaDiaria {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Nullable a propósito: una fila importada de Notion puede no traer fecha.
  // Las que crea la app desde acá sí la llevan siempre (localToday() de
  // Ecuador, puesto en la route — nunca @default(now()), que sería la fecha
  // UTC equivocada durante las primeras horas del día en Ecuador).
  fecha DateTime?

  ownerId          String?
  owner            User?   @relation("TareaResponsable", fields: [ownerId], references: [id])
  // Nombre crudo de Notion cuando no matcheó ningún User del equipo.
  responsableTexto String?

  productId     String?
  product       Product? @relation("TareaProducto", fields: [productId], references: [id], onDelete: SetNull)
  productoTexto String?

  plataforma      String? // TIKTOK | META | DRIVE
  campanaTiktok   Boolean @default(false)
  campanaMeta     Boolean @default(false)
  numeroCreativos Int     @default(0)

  estado    String   @default("PENDIENTE") // PENDIENTE | EN_PROGRESO | HECHO | NO_CUMPLIDO | POR_PAUTAR
  etiquetas String[] @default([])
  notas     String?

  loteId String?
  lote   Ronda?  @relation("TareaLote", fields: [loteId], references: [id], onDelete: SetNull)

  // "notion" para las filas que vinieron del import único; null para las que
  // nacieron en la app. notionPageId es la clave de idempotencia del import
  // — permite re-correrlo sin duplicar.
  origen       String?
  notionPageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, notionPageId])
  @@index([organizationId, fecha])
  @@index([organizationId, ownerId])
}

// Una campaña de "gestión de campañas" (Notion) que todavía no cruza con
// ninguna Campaign sincronizada de Meta/TikTok — planeada, o recién lanzada
// y el sync de 5 minutos no la levantó todavía. Cuando sí aparece la
// Campaign real, esta fila se borra (ver relinkCampaignsToProducts /
// syncWindsorConnector) para no duplicar.
model CampanaManual {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  nombre        String
  productId     String?
  product       Product? @relation("CampanaManualProducto", fields: [productId], references: [id], onDelete: SetNull)
  productoTexto String?
  plataforma    String?
  activa        Boolean  @default(true)
  notas         String?

  origen       String?
  notionPageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, notionPageId])
  @@index([organizationId, activa])
}

// La conexión al import único de Notion. Vive el token mientras dura la
// migración; se limpia al desconectar (el "corte" con Notion).
model NotionConnection {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])

  token              String? // Internal Integration Secret, en texto plano — mismo patrón que AdAccount.accessToken
  tareasDatabaseId   String?
  campanasDatabaseId String?
  connectedAt        DateTime?
  lastImportAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Idempotencia del cierre de día: evita mandar la notificación dos veces
// cuando el reloj interno de 5 minutos vuelve a pasar por el mismo día.
// Mismo patrón que WeeklyReport.
model CierreSeguimiento {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  fecha          DateTime
  resumen        String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, fecha])
}
